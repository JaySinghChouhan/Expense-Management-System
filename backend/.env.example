PORT=5000
NODE_ENV=development
# Local MongoDB, or an Atlas URI once Cluster0 is ready:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/expense_management?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/expense_management
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
# Comma-separated browser origins allowed to call the API (Vercel URL in production)
CLIENT_URL=http://localhost:5173
# Set to true on first Render boot to create demo admin/user and sample expenses
SEED_DEMO=false
