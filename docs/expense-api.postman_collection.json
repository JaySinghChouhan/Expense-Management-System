{
  "info": {
    "name": "Expense Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "expenseId", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@12345\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "List expenses",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/expenses?page=1&limit=10&sortBy=date&order=desc"
      }
    },
    {
      "name": "Create expense",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.data && body.data._id) pm.collectionVariables.set('expenseId', body.data._id);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Airport cab\",\n  \"amount\": 450,\n  \"category\": \"Travel\",\n  \"date\": \"2026-11-20\",\n  \"paymentMethod\": \"UPI\",\n  \"description\": \"Drop to the terminal\"\n}" },
        "url": "{{baseUrl}}/expenses"
      }
    },
    {
      "name": "Get expense",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/expenses/{{expenseId}}" }
    },
    {
      "name": "Update expense",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 500,\n  \"version\": 0\n}" },
        "url": "{{baseUrl}}/expenses/{{expenseId}}"
      }
    },
    {
      "name": "Approve expense",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Approved\"\n}" },
        "url": "{{baseUrl}}/expenses/{{expenseId}}/approve"
      }
    },
    {
      "name": "Reject expense",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Missing receipt\"\n}" },
        "url": "{{baseUrl}}/expenses/{{expenseId}}/reject"
      }
    },
    {
      "name": "Delete expense",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/expenses/{{expenseId}}" }
    },
    {
      "name": "Dashboard summary",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/dashboard/summary?year=2026" }
    },
    {
      "name": "Export CSV",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/reports/expenses/export" }
    }
  ]
}
